# =============================================================================
# MTA Market — environment matrix (PLAN-004 A-001)
#
# DEVELOPMENT (this file as-is) / STAGING / PRODUCTION
#
# Rules (A-001):
#   - Never copy a dev `.env` to staging/production: dev rate limits and dev
#     secrets MUST NOT leak into a deployed environment.
#   - Every value marked PROD: REQUIRED must be a unique, generated secret.
#     Generate secrets with `openssl rand -base64 64` (or the per-var command).
#   - docker-compose.prod.yml reads exactly the variables marked for PROD.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# PROD: REQUIRED. min 32 chars. openssl rand -base64 64
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NODE_ENV=development              # PROD: production (enables fail-fast validation)

# --- Docker compose infra ------------------------------------------------------
# PROD: REQUIRED (no default). Postgres superuser password.
POSTGRES_USER=mtamarket
POSTGRES_PASSWORD=
# PROD: REQUIRED — owner of ghcr images (org/repo). Empty = broken image ref.
GITHUB_REPOSITORY=
# PROD: REQUIRED for deploy; exact CI SHA tag (K-004). "latest" is dev-only.
IMAGE_TAG=latest

# --- OAuth2 Discord -------------------------------------------------------------
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# PROD: https://<domain>/auth/discord/callback (S-003)
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# --- URLs ------------------------------------------------------------------------
BASE_URL=http://localhost:3001          # PROD: https://api host (public backend URL)
FRONTEND_URL=http://localhost:3000      # PROD: https://<domain>
NEXT_PUBLIC_API_URL=http://localhost:3001  # PROD: https://<domain>/api

# --- CORS / cookies (G-005, A-005) ----------------------------------------------
# Explicit browser origin allowlist, comma-separated. Production is
# same-origin behind nginx (/api/ -> backend) and leaves this empty.
CORS_ORIGINS=http://localhost:3000
# lax (same-origin prod) | strict | none (cross-origin; forces Secure)
COOKIE_SAMESITE=lax
# PLAN-004 A-004: trust one proxy hop (nginx). Set "false" ONLY if the backend
# is exposed directly (never in production topology).
TRUST_PROXY=true

# --- Storage (B-003/B-004) --------------------------------------------------------
# PROD: REQUIRED true — local filesystem is not a durable production storage
# and startup validation fails closed without S3.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=                          # PROD: REQUIRED when S3_ENABLED=true
S3_SECRET_KEY=                          # PROD: REQUIRED when S3_ENABLED=true (secret)
S3_ENDPOINT=                            # Cloudflare R2 endpoint when applicable
S3_SIGNED_URL_TTL=300                   # artifact download TTL (capped at 900)
# PROD (B-002): public/CDN base for media delivery (no trailing slash).
# Empty = backend streams media objects from the bucket itself.
MEDIA_PUBLIC_BASE_URL=
# PROD: local upload dir (dev fallback; production must use S3)
UPLOAD_DIR=./uploads

# --- DRM v2 (workstream F) ---------------------------------------------------------
# Server lease signing key (Ed25519 PKCS8 DER, base64).
# Generate with: pnpm --filter @mta-market/server drm:keygen
# PROD: REQUIRED.
DRM_SERVER_PRIVATE_KEY=
# DEK envelope-encryption master key (AES-256, base64 of 32 bytes).
# Generate with: openssl rand -base64 32
# PROD: REQUIRED. Losing it makes existing encrypted versions unrecoverable
# (back it up together with the DB — see docs/operations/backup-restore.md).
DRM_MASTER_KEY=
# Artifact signing key (Ed25519 PKCS8 DER, base64) — platform signs
# artifacts on behalf of publishers. PROD: REQUIRED.
ARTIFACT_SIGNING_PRIVATE_KEY=

# --- Rate limits (A-003) -------------------------------------------------------------
# DEV/E2E profile below is INTENTIONALLY loose for browser E2E runs.
# PROD values (pinned as defaults in docker-compose.prod.yml):
#   AUTH=100/15min, STANDARD=300/min, STRICT=10/min, LOGIN=10/min/account,
#   REFRESH=30/min/account. Do NOT copy dev values to production.
AUTH_RATE_LIMIT_MAX=5
STANDARD_RATE_LIMIT_MAX=60
STRICT_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30
# M-002: security-critical limiters fail closed when Redis is down (503).
# The global standard limiter defaults to fail-open; set true to hard-fail it.
RATE_LIMIT_FAIL_CLOSED=false
# M-002: queue Redis commands while reconnecting? false = fail fast (prod).
REDIS_ENABLE_OFFLINE_QUEUE=true

# --- Payments (workstream D) ------------------------------------------------------------
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=                       # PROD: REQUIRED when enabled
YOOKASSA_SECRET_KEY=                    # PROD: REQUIRED when enabled (secret)
YOOKASSA_NOTIFICATION_PASSWORD=         # PROD: REQUIRED when enabled (secret)

# --- Email (workstream N) ------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                              # secret
EMAIL_FROM=                             # PROD: noreply@<production-domain>

# --- Jobs / observability (I, J) ---------------------------------------------------------------
RECONCILIATION_ENABLED=true             # PROD: must stay true (D-006)
RECONCILIATION_INTERVAL_MS=86400000
RECONCILIATION_INITIAL_DELAY_MS=60000
LOG_FORMAT=pretty                       # PROD: json
LOG_LEVEL=info

# --- Server community monitoring (PLAN-005 E-006) ----------------------------------------------
# Sweep marks ONLINE servers as UNKNOWN when the integration heartbeat stops
# arriving (never OFFLINE — "system doesn't know" != "server is down") and
# expires stale review tokens. A heartbeat is fresh for interval*3 seconds.
SERVER_MONITORING_ENABLED=true          # false disables the sweep job
SERVER_MONITORING_INTERVAL_MS=60000
SERVER_HEARTBEAT_INTERVAL_SECONDS=60    # advertised to owners (stale = 3x this)
