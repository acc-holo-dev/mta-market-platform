{
  "name": "@mta-market/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "drm:keygen": "tsx src/cli/drm.ts keygen",
    "drm:test-installation": "tsx src/cli/drm.ts test-installation",
    "drm:generate-nonce": "tsx src/cli/drm.ts generate-nonce",
    "drm:info": "tsx src/cli/drm.ts info",
    "reconciliation:run": "tsx -e \"require('./src/jobs/reconciliation').runDailyReconciliation()\"",
    "reconciliation:summary": "tsx -e \"require('./src/lib/reconciliation/service').getReconciliationSummary().then(console.log)\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.8",
    "unzipper": "^0.12.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@mta-market/eslint-config": "workspace:*",
    "@mta-market/tsconfig": "workspace:*",
    "@prisma/cli-engine": "0.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "prisma": "8.0.0-rc.13",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
