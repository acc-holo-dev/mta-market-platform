# Server-local dev environment template (apps/server).
# The full environment matrix with PROD/STAGING guidance lives in the repo
# root .env.example (PLAN-004 A-001); this file covers the local dev server.
# Never copy a filled .env into another environment.

# Database
DATABASE_URL="postgresql://mtamarket:dev_password@localhost:5432/mtamarket"

# JWT
# Generate with: openssl rand -base64 64
JWT_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OAuth2 Discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:3001/auth/discord/callback"

# Redis (rate-limit counters only — ephemeral, see PLAN-004 M-003)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLE_OFFLINE_QUEUE="true"

# Server
PORT=3001
BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# File Upload
UPLOAD_DIR="./uploads"

# S3 / Cloudflare R2 (optional in dev; required in production)
S3_ENABLED="false"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT="" # For Cloudflare R2: https://account-id.r2.cloudflarestorage.com
# Controlled public media base (B-002); empty = backend streams from bucket.
MEDIA_PUBLIC_BASE_URL=""

# YooKassa (optional)
YOOKASSA_ENABLED="false"
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_NOTIFICATION_PASSWORD=""
# Signed download URL TTL in seconds (default 300, max 900)
S3_SIGNED_URL_TTL="300"

# Email (optional)
EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Rate limits (A-003: dev/E2E values; production defaults are pinned in
# docker-compose.prod.yml — see root .env.example)
# AUTH_RATE_LIMIT_MAX=2000
# STANDARD_RATE_LIMIT_MAX=2000
# STRICT_RATE_LIMIT_MAX=60
# LOGIN_RATE_LIMIT_MAX=500
# REFRESH_RATE_LIMIT_MAX=400

# DRM v2 (workstream F; required in production — see root .env.example)
# Generate with: pnpm --filter @mta-market/server drm:keygen
DRM_SERVER_PRIVATE_KEY=""
# openssl rand -base64 32
DRM_MASTER_KEY=""
ARTIFACT_SIGNING_PRIVATE_KEY=""

# Jobs / observability
RECONCILIATION_ENABLED="true"
LOG_FORMAT="pretty"
LOG_LEVEL="info"

# PLAN-005: server monitoring sweep (E-006) — marks stale heartbeats UNKNOWN
# and expires stale review tokens. Interval in ms (default 60000 = 1 min).
# SERVER_MONITORING_ENABLED="true"
# SERVER_MONITORING_INTERVAL_MS=60000
# A heartbeat is "fresh" for interval*3 seconds (default 60s*3 = 3 min);
# ONLINE servers whose heartbeat stops arriving degrade to UNKNOWN, never OFFLINE.
SERVER_HEARTBEAT_INTERVAL_SECONDS=60
